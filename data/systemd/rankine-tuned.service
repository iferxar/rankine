[Unit]
Description=Rankine tuning helper
Documentation=https://github.com/iferxar/rankine/blob/main/docs/TUNING.md

[Service]
Type=dbus
BusName=io.github.iferxar.Rankine.Tuned
ExecStart=/usr/bin/rankine-tuned
# A clean stop restores the cards itself; this covers a crash, using the baseline left in /run.
ExecStopPost=/usr/bin/rankine-tuned --reset
RuntimeDirectory=rankine-tuned

# Writes go to /sys, which ProtectSystem=strict leaves writable; ProtectKernelTunables would not.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
